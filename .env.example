# Copy to .env (same folder as docker-compose.yml) only if you need to change something.
# Ports on your computer
WEB_PORT=3000
GATEWAY_PORT=8080
# First admin account (created on first start only)
ADMIN_EMAIL=admin@cargorent.com
ADMIN_PASSWORD=Admin@123
# Shared JWT secret for user-service and gateway (at least 32 characters)
JWT_SECRET=cargorent-dev-secret-change-me-please-32chars-min
