{
  "info": {
    "name": "CarGoRent API (via gateway)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run top to bottom (Collection Runner works). Tokens and ids are saved into collection variables automatically. Test-mode payments only."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    },
    {
      "key": "vehicleId",
      "value": "1"
    },
    {
      "key": "startDate",
      "value": ""
    },
    {
      "key": "endDate",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pickup today, return in 3 days (local time)",
          "const z = n => String(n).padStart(2, '0');",
          "const f = d => `${d.getFullYear()}-${z(d.getMonth() + 1)}-${z(d.getDate())}`;",
          "if (!pm.collectionVariables.get('startDate')) {",
          "  const s = new Date(); const e = new Date(); e.setDate(e.getDate() + 3);",
          "  pm.collectionVariables.set('startDate', f(s)); pm.collectionVariables.set('endDate', f(e));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register customer",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Customer\",\n  \"email\": \"postman.{{$timestamp}}@cargorent.test\",\n  \"password\": \"Test@123\",\n  \"phone\": \"9876543210\",\n  \"address\": \"Kochi\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('customerToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
